datasource db {
   url      = env("DATABASE_URL")
   provider = "postgresql"
}

generator client {
   provider = "prisma-client-js"
}

model ItemType {
   id   String @id @default(cuid())
   name String @unique

   items Item[]
}

model Item {
   id           String   @id @default(cuid())
   createdAt    DateTime @default(now())
   updatedAt    DateTime @updatedAt
   name         String
   price        Float
   description  String
   idItemType   String
   type         ItemType @relation(fields: [idItemType], references: [id])
   commentsList Review[]
   img          String?
   action       Int?

   @@map("Item")
}

model Review {
   id        String   @id @default(cuid())
   createdAt DateTime @default(now())
   userName  String
   text      String
   stars     Int
   Item      Item?    @relation(fields: [itemId], references: [id])
   itemId    String?
}

model ContactForm {
   id        String   @id @default(cuid())
   createdAt DateTime @default(now())
   name      String
   email     String
   message   String
}
